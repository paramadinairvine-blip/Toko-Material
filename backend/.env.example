# Server
# macOS: port 5000 dipakai AirPlay Receiver. Kalau bentrok, ganti PORT (mis. 5001) lalu
# isi DEV_API_TARGET=http://localhost:5001 di frontend/.env.local dan pos/.env.local.
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/toko_material?schema=public"
# Koneksi langsung untuk migrasi Prisma. Sama dengan DATABASE_URL kecuali memakai connection pooler.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/toko_material?schema=public"

# JWT — GANTI dengan secret yang kuat di production!
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5000

# Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Telegram (opsional) — notifikasi dan laporan harian
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
